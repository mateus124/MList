{
  "manifest_version": 3,
  "name": "MList",
  "version": "1.1.0",
  "description": "Dashboard de links para produtividade em sua nova aba",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "MList - Dashboard de Links"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "128": "icone.png"
  }
}